{
  "name": "react-native-verus",
  "version": "0.7.0-verussky.1",
  "description": "Verus Sapling encryption (verus_zfunc) for React Native, as an Expo module",
  "homepage": "https://github.com/mcstoer/react-native-verus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcstoer/react-native-verus.git"
  },
  "license": "MIT",
  "author": "Airbitz, Inc.",
  "contributors": [
    "William Swanson <william@edge.app>",
    "Paul Puey <paul@edge.app>",
    "Matthew Piché <matthew@edge.app>",
    "Kevin Gorham <kevin.gorham@z.cash>"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "/android/build.gradle",
    "/android/src/",
    "/CHANGELOG.md",
    "/expo-module.config.json",
    "/ios/",
    "/ios-artifacts.lock",
    "/LICENSE",
    "/package.json",
    "/react-native-verus.podspec",
    "/README.md",
    "/scripts/",
    "/src/"
  ],
  "scripts": {
    "fetch-ios-artifacts": "./scripts/fetch-ios-artifacts.sh",
    "fix-kotlin": "ktlint --format 'android/src/**/*.kt'",
    "fix-swift": "swift-format format -i ios/VerusCryptoModule.swift",
    "prepack": "node -r sucrase/register ./scripts/prepack.ts",
    "typecheck": "tsc --noEmit",
    "update-sources": "node -r sucrase/register ./scripts/updateSources.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "disklet": "0.4.6",
    "expo-modules-core": "58.0.26",
    "sucrase": "3.35.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "expo-modules-core": "*",
    "react-native": "*"
  }
}
